# RAGChat Environment Configuration

# LLM Provider Configuration
# Options: google, openai, anthropic, groq, ollama, lmstudio
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_api_key_here

# Local LLM Endpoint (Optional: for Ollama / LM Studio)
# LLM_BASE_URL=http://localhost:11434

# Discord Channel Targets (Optional: comma-separated channel IDs)
# DISCORD_TARGETS=123456789,987654321

# Rename this file to .env and fill in your values
# NEVER commit the actual .env file to GitHub

# ─────────────────────────────────────────────────
# LLM Provider Selection
# ─────────────────────────────────────────────────
# Choose your LLM provider. Options:
#   google      → Google AI Studio (Gemini / Gemma)
#   openai      → OpenAI (GPT-4o, GPT-4o-mini, etc.)
#   groq        → Groq Cloud (fast inference, free tier)
#   together    → Together AI
#   mistral     → Mistral AI
#   anthropic   → Anthropic (Claude)
#   ollama      → Ollama local (no API key needed)
#   lmstudio    → LM Studio local (no API key needed)
#   custom      → Any OpenAI-compatible endpoint
LLM_PROVIDER=google

# ─────────────────────────────────────────────────
# API Key (leave blank for local providers like Ollama / LM Studio)
# ─────────────────────────────────────────────────
LLM_API_KEY=your_api_key_here

# ─────────────────────────────────────────────────
# Model Name
# ─────────────────────────────────────────────────
# Leave blank to use the default model for the selected provider.
# Examples by provider:
#   google    → gemma-4-31b-it, gemini-2.0-flash, gemini-1.5-pro
#   openai    → gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#   groq      → llama-3.3-70b-versatile, mixtral-8x7b-32768
#   anthropic → claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#   ollama    → llama3, mistral, codellama, phi3 (must be pulled first)
#   lmstudio  → whatever model you have loaded in LM Studio
LLM_MODEL=

# ─────────────────────────────────────────────────
# Custom Base URL (optional)
# ─────────────────────────────────────────────────
# Override the API endpoint. Required for "custom" provider.
# Defaults are set automatically for known providers:
#   ollama   → http://localhost:11434/v1
#   lmstudio → http://localhost:1234/v1
LLM_BASE_URL=
